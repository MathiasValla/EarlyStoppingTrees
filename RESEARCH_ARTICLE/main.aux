\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Global Pareto comparison of exhaustive, secretary-style, and ExtraTrees-style split-search methods. Each point represents one dataset summarized by the median over 50 runs. The horizontal axis reports the median percentage of training time saved relative to the exhaustive \texttt  {scikit-learn} splitter, and the vertical axis reports the median percentage loss relative to the same baseline. Left: regression with RMSE loss. Middle: classification with Gini impurity and F1 loss. Right: classification with entropy impurity and F1 loss. Large white-edged markers indicate the cross-dataset medians of the corresponding methods.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:pareto_main}{{1}{7}{Global Pareto comparison of exhaustive, secretary-style, and ExtraTrees-style split-search methods. Each point represents one dataset summarized by the median over 50 runs. The horizontal axis reports the median percentage of training time saved relative to the exhaustive \texttt {scikit-learn} splitter, and the vertical axis reports the median percentage loss relative to the same baseline. Left: regression with RMSE loss. Middle: classification with Gini impurity and F1 loss. Right: classification with entropy impurity and F1 loss. Large white-edged markers indicate the cross-dataset medians of the corresponding methods}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Representative global summary by method after the optimized 50-run rerun. The $n/e$ schedule is used for the secretary families, the low-overhead \((10,q=0.5)\) configuration is used for \(S_{\mathrm  {par}}\) in classification, and all four ExtraTrees \texttt  {max\_features} budgets are shown. Speedup is relative to the exhaustive \texttt  {scikit-learn} splitter. Effort saved is the median percentage reduction in gain evaluations relative to exhaustive split search; negative values indicate methods whose replay logic performs more exact gain evaluations than the exhaustive baseline. Loss is expressed in percent.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:summary_results}{{2}{8}{Representative global summary by method after the optimized 50-run rerun. The $n/e$ schedule is used for the secretary families, the low-overhead \((10,q=0.5)\) configuration is used for \(S_{\mathrm {par}}\) in classification, and all four ExtraTrees \texttt {max\_features} budgets are shown. Speedup is relative to the exhaustive \texttt {scikit-learn} splitter. Effort saved is the median percentage reduction in gain evaluations relative to exhaustive split search; negative values indicate methods whose replay logic performs more exact gain evaluations than the exhaustive baseline. Loss is expressed in percent}{table.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Reliability and dataset structure}{9}{subsection.3.3}\protected@file@percent }
